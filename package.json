{
  "name": "moda-interact-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build --webpack",
    "start": "node --import ./observability.mjs ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "test": "node --test tests/observability/*.test.mjs tests/security/*.test.mjs",
    "test:arch033-admin-incidents:postgres": "node scripts/test-arch033-admin-incidents-postgres.mjs",
    "test:arch043-admin-auth:unit": "node --experimental-strip-types --test tests/unit/arch043-platform-auth-resolution.test.ts tests/unit/arch043-platform-auth-lazy-wiring.test.mjs",
    "test:arch043-admin-auth:rotation": "node --conditions=import --import tsx --test tests/unit/arch043-platform-auth-session-rotation.test.ts",
    "test:arch043-admin-secrets:unit": "node --conditions=import --import tsx --test tests/unit/arch043-platform-secrets.test.ts tests/unit/arch043-platform-secret-access.test.ts",
    "test:arch043-admin-config:unit": "tsx --test tests/unit/arch043-platform-configuration-contracts.test.ts tests/unit/arch043-platform-configuration-ui.test.mjs tests/unit/arch043-platform-secret-reveal-ui.test.mjs",
    "test:arch043-admin-config:components": "tsx --test tests/unit/arch043-platform-configuration-components.test.tsx",
    "test:arch043-admin-config:postgres": "node scripts/test-arch043-admin-configuration-postgres.mjs",
    "update_platform": "node --conditions=import --import tsx scripts/update_platform.mjs",
    "test:arch040-admin-human-messaging:unit": "node --experimental-strip-types --test tests/unit/arch040-human-messaging-contract.test.ts && node --test tests/security/admin-human-messaging.test.mjs",
    "test:arch040-admin-human-messaging:postgres": "node scripts/test-arch040-admin-human-messaging-postgres.mjs",
    "test:update-platform": "node --test tests/unit/update-platform-import.test.mjs",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema database/prisma/schema.prisma",
    "test:arch047-admin-authoring:unit": "tsx --test tests/unit/arch047-template-authoring-ast.test.ts tests/unit/arch047-template-authoring-service.test.ts tests/unit/arch047-template-authoring-components.test.tsx",
    "test:arch047-admin-authoring:postgres": "node scripts/test-arch047-admin-authoring-postgres.mjs",
    "test:arch047-admin-translations:unit": "node scripts/test-arch047-admin-translations-esm.mjs tests/unit/arch047-template-translations.test.ts tests/unit/arch047-template-translation-components.test.tsx",
    "test:arch047-admin-translations:postgres": "npm run prisma:generate && node scripts/test-arch047-admin-translations-postgres.mjs",
    "admin:provision": "node scripts/provision-platform-admin.mjs",
    "admin:seed-promotions": "node scripts/seed-promotion-test-data.mjs",
    "admin:clear-promotions": "node scripts/seed-promotion-test-data.mjs --clear",
    "admin:seed-merchant-pricing": "node scripts/seed-manual-merchant-pricing.mjs",
    "admin:clear-merchant-pricing": "node scripts/clear-merchant-pricing.mjs",
    "admin:seed-four-merchant-pricing": "node scripts/seed-four-merchant-pricing.mjs",
    "admin:seed-core-merchant-pricing": "node scripts/seed-core-merchant-pricing.mjs",
    "admin:seed-promotion": "node scripts/seed-manual-promotion.mjs",
    "admin:seed-usage-overview": "node scripts/seed-usage-overview-test-data.mjs",
    "admin:delete-merchant-data": "node scripts/delete-merchant-data.mjs",
    "shopify-taxonomy:sync": "node scripts/sync-shopify-taxonomy.mjs",
    "test:arch047-admin-compilation:unit": "tsx --test tests/unit/arch047-template-compilation.test.ts tests/unit/arch047-template-compilation-service.test.ts",
    "test:arch047-admin-compilation:postgres": "node scripts/test-arch047-admin-compilation-postgres.mjs",
    "test:arch047-admin-compilation:components": "tsx --test tests/unit/arch047-template-compilation-components.test.tsx"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@modainteract/moda-interact-shared": "2.5.0",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.3.4",
    "codemirror": "^6.0.2",
    "exceljs": "4.4.0",
    "ioredis": "^6.0.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "esbuild": "0.28.2"
  }
}
