# =============================================================================
# Runtime environment
# =============================================================================

# Deployment/environment identity used by the application and telemetry.
# The development authentication bypass remains fail-closed in production.
# Examples: development, test, production
DEPLOYMENT_ENVIRONMENT_NAME=development
GRAFANA_BASE_URL=
GRAFANA_PLATFORM_DASHBOARD_URL=
GRAFANA_LOGS_URL=
GRAFANA_TRACES_URL=
GRAFANA_METRICS_URL=


# =============================================================================
# Database
# =============================================================================

# Shared Moda Interact PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Redis used by the read-only Shopify queue monitor. Keep this server-side.
REDIS_URL=


# =============================================================================
# Platform admin authentication
# =============================================================================

# Development bypass is enabled by default for backwards compatibility.
# Set to false to use real Google/SUPER_ADMIN login when testing secret management.
# This never enables bypass in production.
# ADMIN_DEVELOPMENT_AUTH_BYPASS=false

# Required when authentication is enabled in test or production,
# or when the development bypass above is explicitly disabled.
AUTH_URL=
AUTH_SECRET=

# Google OAuth credentials for platform-admin authentication.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
